    "@types/pdfkit": "^0.13.4",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0",
    "prisma": "^5.10.0",
    "resend": "^3.2.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
